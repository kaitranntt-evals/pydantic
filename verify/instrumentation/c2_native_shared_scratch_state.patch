+// VERIFY MUTATION (C2): every native invocation works in one process-wide scratch state (seeded from, and
+// copied back to, the caller's containers), so two invocations that are in flight together clobber each other.
+static SCRATCH: pyo3::sync::PyOnceLock<(Py<PyDict>, Py<PyList>, Py<PyDict>, Py<PyList>)> = pyo3::sync::PyOnceLock::new();
+
+fn replace_list<'py>(target: &Bound<'py, PyList>, source: &Bound<'py, PyList>) -> PyResult<()> {
+    target.del_slice(0, target.len())?;
+    for item in source.iter() {
+        target.append(item)?;
+    }
+    Ok(())
+}
